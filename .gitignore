# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging and build artifacts
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Local environment and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local databases and generated data
*.db
*.sqlite
*.sqlite3
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local editor and IDE settings
.vscode/
.idea/

# OS and filesystem metadata
.DS_Store
._*
.AppleDouble
__MACOSX/
Thumbs.db
